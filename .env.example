# --- Database -----------------------------------------------------------
# Local development default (SQLite file). For Supabase, use the connection
# string from Project Settings -> Database and install the driver:
#   pip install "psycopg[binary]"
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./rein.db

# --- LLM provider -------------------------------------------------------
# Chat assistant uses Ollama by default; extraction uses Anthropic by default.
# Override either one if you want both paths to use the same provider.
CHAT_LLM_PROVIDER=ollama
EXTRACTION_LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=16000

# Anthropic (Claude) — pip install langchain-anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Ollama (local, no API key) — pip install langchain-ollama, run `ollama serve`
# Use a model that supports tools/structured output.
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# Azure OpenAI — pip install langchain-openai
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21

# Define the provider to use for the chat LLM and the extraction LLM. Options: "azure_openai", "ollama", "anthropic"
CHAT_LLM_PROVIDER=ollama
EXTRACTION_LLM_PROVIDER=anthropic
